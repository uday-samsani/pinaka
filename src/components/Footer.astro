---
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

const wittyLines = [
  "Built with impatience and stubbornness.",
  "Crafted while overthinking.",
  "Made with caffeine and curiosity.",
  "Assembled with chaotic good energy.",
  "Created by a professional amateur.",
];

const randomWittyLine =
  wittyLines[Math.floor(Math.random() * wittyLines.length)];
---

<footer
  class={`${noMarginTop ? "" : "mt-auto"} w-full border-t border-skin-line bg-skin-fill`}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Top Section -->
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-8"
    >
      <!-- Brand -->
      <div class="space-y-3">
        <a
          href="/"
          class="text-xl font-serif font-semibold hover:text-primary-600 transition-colors duration-200"
        >
          The Fool
        </a>
        <p class="text-sm text-skin-base-muted max-w-xs">
          {randomWittyLine}
        </p>
      </div>

      <!-- Quick Links -->
      <nav class="flex flex-wrap gap-6 text-sm">
        <a
          href="/posts/"
          class="text-skin-base-muted hover:text-primary-600 transition-colors duration-200"
        >
          Posts
        </a>
        <a
          href="/tags/"
          class="text-skin-base-muted hover:text-primary-600 transition-colors duration-200"
        >
          Tags
        </a>
        <a
          href="/about/"
          class="text-skin-base-muted hover:text-primary-600 transition-colors duration-200"
        >
          About
        </a>
        <a
          href="/rss.xml"
          class="text-skin-base-muted hover:text-primary-600 transition-colors duration-200"
        >
          RSS
        </a>
      </nav>
    </div>

    <!-- Divider -->
    <div class="my-8 border-t border-skin-line"></div>

    <!-- Bottom Section -->
    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
    >
      <!-- Copyright -->
      <p class="text-sm text-skin-base-muted">
        &copy; {currentYear} All rights reserved. Or wrongs. We're flexible.
      </p>

      <!-- Socials -->
      <Socials />
    </div>
  </div>
</footer>

<style>
  /* Socials component styling override */
  footer :global(.social-icons) {
    @apply flex items-center gap-4;
  }

  footer :global(.social-icons a) {
    @apply text-skin-base-muted hover:text-primary-600 transition-colors duration-200;
  }

  footer :global(.social-icons svg) {
    @apply h-5 w-5;
  }
</style>
