---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class={`inline-block ${size === "sm" ? "my-1" : "my-3 mx-1"}`}>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-skin-fill-muted border border-skin-line text-skin-base-muted hover:text-primary-600 hover:border-primary-500/30 hover:bg-primary-500/5 transition-all duration-200 group ${size === "sm" ? "text-sm" : "text-base"}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class={`transition-transform duration-200 group-hover:rotate-12 ${size === "sm" ? "h-3.5 w-3.5" : "h-4 w-4"}`}
    >
      <path
        d="M16.018 3.815 15.232 8h-4.966l.716-3.815-1.964-.37L8.232 8H4v2h3.857l-.751 4H3v2h3.731l-.714 3.805 1.965.369L8.766 16h4.966l-.714 3.805 1.965.369.783-4.174H20v-2h-3.859l.751-4H21V8h-3.733l.716-3.815-1.965-.37zM14.106 14H9.141l.751-4h4.966l-.752 4z"
      ></path>
    </svg>
    <span>{tag}</span>
  </a>
</li>
