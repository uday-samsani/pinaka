---
import { SITE } from "@config";

export interface Props {
  activeNav?: "posts" | "tags" | "about" | "search";
}

const { activeNav } = Astro.props;

const navItems = [
  { path: "/posts/", label: "Posts", id: "posts" },
  { path: "/tags/", label: "Tags", id: "tags" },
  { path: "/about/", label: "About", id: "about" },
];
---

<header
  class="sticky top-0 z-50 w-full bg-skin-fill/80 backdrop-blur-xl border-b border-skin-line transition-all duration-300"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span
          class="text-xl sm:text-2xl font-serif font-semibold tracking-tight group-hover:text-primary-600 transition-colors duration-200"
        >
          {SITE.title}
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        {
          navItems.map(item => (
            <a
              href={item.path}
              class={`text-sm font-medium transition-colors duration-200 relative group py-1 ${
                activeNav === item.id
                  ? "text-primary-600"
                  : "text-skin-base-muted hover:text-skin-base"
              }`}
            >
              {item.label}
              <span
                class={`absolute -bottom-0.5 left-0 h-0.5 bg-primary-500 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] ${
                  activeNav === item.id ? "w-full" : "w-0 group-hover:w-full"
                }`}
              />
            </a>
          ))
        }

        <!-- Search -->
        <a
          href="/search/"
          class={`p-2 rounded-lg transition-colors duration-200 ${
            activeNav === "search"
              ? "text-primary-600 bg-primary-500/10"
              : "text-skin-base-muted hover:text-skin-base hover:bg-skin-card"
          }`}
          aria-label="Search"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </a>

        <!-- Theme Toggle -->
        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="p-2 rounded-lg text-skin-base-muted hover:text-skin-base hover:bg-skin-card transition-colors duration-200"
              title="Toggle theme"
              aria-label="Toggle light & dark mode"
              aria-live="polite"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                id="moon-svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                />
              </svg>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                id="sun-svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                />
              </svg>
            </button>
          )
        }
      </nav>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href="/search/"
          class={`p-2 rounded-lg transition-colors duration-200 ${
            activeNav === "search"
              ? "text-primary-600 bg-primary-500/10"
              : "text-skin-base-muted"
          }`}
          aria-label="Search"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </a>

        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn-mobile"
              class="p-2 rounded-lg text-skin-base-muted"
              title="Toggle theme"
              aria-label="Toggle light & dark mode"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                id="moon-svg-mobile"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                />
              </svg>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                id="sun-svg-mobile"
                class="h-5 w-5 hidden"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                />
              </svg>
            </button>
          )
        }

        <button
          id="mobile-menu-btn"
          class="p-2 rounded-lg text-skin-base-muted hover:bg-skin-card transition-colors duration-200"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
              id="menu-icon-open"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
              id="menu-icon-close"
              class="hidden"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      class="hidden md:hidden border-t border-skin-line py-4"
    >
      <nav class="flex flex-col gap-2">
        {
          navItems.map(item => (
            <a
              href={item.path}
              class={`px-4 py-3 rounded-lg text-base font-medium transition-colors duration-200 ${
                activeNav === item.id
                  ? "text-primary-600 bg-primary-500/10"
                  : "text-skin-base-muted hover:text-skin-base hover:bg-skin-card"
              }`}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIconOpen = document.getElementById("menu-icon-open");
  const menuIconClose = document.getElementById("menu-icon-close");

  function toggleMobileMenu() {
    const isExpanded = mobileMenuBtn?.getAttribute("aria-expanded") === "true";
    mobileMenuBtn?.setAttribute("aria-expanded", isExpanded ? "false" : "true");
    mobileMenu?.classList.toggle("hidden");
    menuIconOpen?.classList.toggle("hidden");
    menuIconClose?.classList.toggle("hidden");
  }

  mobileMenuBtn?.addEventListener("click", toggleMobileMenu);

  // Re-attach event listener after view transitions
  document.addEventListener("astro:after-swap", () => {
    const newMobileMenuBtn = document.getElementById("mobile-menu-btn");
    newMobileMenuBtn?.addEventListener("click", toggleMobileMenu);
  });
</script>
