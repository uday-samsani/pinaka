# Optional: TinaCMS Configuration
# These are only needed if you want to use TinaCMS admin
# For static builds without CMS, leave these empty or unset

# Get these from https://tina.io
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Optional: Cloudinary for media (requires TinaCloud)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
